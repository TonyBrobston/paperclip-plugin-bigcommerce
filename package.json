{
  "name": "paperclip-plugin-bigcommerce",
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only BigCommerce access for Paperclip agents: catalog products and variants, categories, brands, orders and line items, customers and per-location inventory.",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node ./scripts/smoke.mjs"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "bigcommerce",
    "ecommerce",
    "connector"
  ],
  "author": "Tony Brobston",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.1012.0",
    "@paperclipai/shared": "^2026.1012.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
